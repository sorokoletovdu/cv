---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Dmitrii Sorokoletov — CV' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/cv/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <!-- Prevent flash of unstyled theme: apply .dark before first paint -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-gray-50 dark:bg-neutral-900 text-(--color-dark) font-sans antialiased">
    <!-- Download bar -->
    <div class="bg-white dark:bg-neutral-800 border-b border-gray-200 dark:border-neutral-700 print:hidden">
      <div class="max-w-[794px] mx-auto px-4 sm:px-6 py-3 flex justify-between items-center gap-3">
        <span class="text-sm text-(--color-gray)">Dmitrii Sorokoletov — CV</span>
        <div class="flex items-center gap-3">
          <!-- Theme toggle -->
          <button
            id="theme-toggle"
            aria-label="Toggle dark mode"
            class="w-8 h-8 flex items-center justify-center rounded text-(--color-gray) hover:text-(--color-dark) transition-colors"
          >
            <!-- Sun: shown in dark mode -->
            <svg class="hidden dark:block w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
            </svg>
            <!-- Moon: shown in light mode -->
            <svg class="block dark:hidden w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
          <a
            href="/cv/Dmitrii_Sorokoletov_CV.pdf"
            download="Dmitrii_Sorokoletov_CV.pdf"
            class="inline-flex items-center gap-2 px-4 py-1.5 text-sm font-semibold text-white dark:text-neutral-900 rounded bg-neutral-700 hover:bg-neutral-600 dark:bg-neutral-200 dark:hover:bg-neutral-300 transition-colors"
          >
            Download PDF
          </a>
        </div>
      </div>
    </div>

    <!-- CV content -->
    <main class="max-w-[794px] mx-auto px-4 sm:px-10 py-6 sm:py-8 bg-white dark:bg-neutral-800 shadow-none sm:shadow-sm my-0 sm:my-6 print:shadow-none print:my-0 print:px-0">
      <slot />
    </main>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
