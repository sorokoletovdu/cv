---
import { linkedInHandle, gitHubHandle } from '../lib/formatUrl';

interface Props {
  name: string;
  title: string;
  phone: string;
  email: string;
  linkedin: string;
  github: string;
  permit: string;
  languages: string[];
}

const { name, title, phone, email, linkedin, github, permit, languages } = Astro.props;
const [firstName, ...lastParts] = name.split(' ');
const lastName = lastParts.join(' ');
const linkedinHandle = linkedInHandle(linkedin);
const githubHandle = gitHubHandle(github);
---

<header class="text-center mb-6 pb-4 border-b border-(--color-rule)">
  <!-- Name -->
  <h1 class="font-heading text-[1.5rem] sm:text-[2rem] font-bold tracking-wide text-(--color-dark) leading-tight uppercase">
    {firstName}
    <span class="font-light">{lastName}</span>
  </h1>

  <!-- Title -->
  <p class="mt-1 text-[0.8rem] text-(--color-gray) font-light tracking-[0.15em] uppercase">
    {title}
  </p>

  <!-- Contact row -->
  <div class="mt-3 flex flex-wrap justify-center gap-x-5 gap-y-1 text-[0.72rem] text-(--color-gray)">
    <a href={`tel:${phone}`} class="hover:text-(--color-dark) transition-colors">
      {phone}
    </a>
    <span aria-hidden="true">·</span>
    <a href={`mailto:${email}`} class="hover:text-(--color-dark) transition-colors">
      {email}
    </a>
    <span aria-hidden="true">·</span>
    <a href={linkedin} target="_blank" rel="noopener" class="hover:text-(--color-dark) transition-colors">
      linkedin.com/in/{linkedinHandle}
    </a>
    <span aria-hidden="true">·</span>
    <a href={github} target="_blank" rel="noopener" class="hover:text-(--color-dark) transition-colors">
      github.com/{githubHandle}
    </a>
  </div>

  <!-- Permit + languages -->
  <p class="mt-1.5 text-[0.7rem] text-(--color-light) tracking-wide">
    {permit} &nbsp;|&nbsp; Languages: {languages.join(', ')}
  </p>
</header>
